-- STEP 59 — Recursive CTE
-- 1. Create a recursive CTE to display a hierarchy of branches from level 1 to level 3.
WITH RECURSIVE BranchHierarchy AS (
    
    -- Anchor member
    SELECT
        branch_id,
        branch_name,
        1 AS level
    FROM Branches
    WHERE branch_id = 1

    UNION ALL

    -- Recursive member
    SELECT
        b.branch_id,
        b.branch_name,
        bh.level + 1
    FROM Branches b
    INNER JOIN BranchHierarchy bh
        ON b.branch_id = bh.branch_id + 1
    WHERE bh.level < 3
)

SELECT
    branch_id,
    branch_name,
    level
FROM BranchHierarchy;

-- 2. Create a recursive CTE to generate numbers from 1 to 10.
WITH RECURSIVE NumberSeries AS (

    -- Starting value
    SELECT 1 AS number

    UNION ALL

    -- Generate next number
    SELECT number + 1
    FROM NumberSeries
    WHERE number < 10
)

SELECT number
FROM NumberSeries;

-- 3. Create a recursive CTE to generate monthly periods from January 2026 to June 2026.
WITH RECURSIVE MonthlyPeriods AS (

    SELECT DATE('2026-01-01') AS month_start

    UNION ALL

    SELECT DATE_ADD(month_start, INTERVAL 1 MONTH)
    FROM MonthlyPeriods
    WHERE month_start < '2026-06-01'
)

SELECT
    month_start,
    DATE_FORMAT(month_start, '%M %Y') AS month_name
FROM MonthlyPeriods;

-- 4. Create a recursive CTE to generate weekly dates from January 1, 2026 to January 31, 2026.
WITH RECURSIVE WeeklyDates AS (

    SELECT DATE('2026-01-01') AS week_date

    UNION ALL

    SELECT DATE_ADD(week_date, INTERVAL 7 DAY)
    FROM WeeklyDates
    WHERE week_date < '2026-01-31'
)

SELECT
    week_date
FROM WeeklyDates;
