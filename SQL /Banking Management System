CREATE TRIGGER AfterAccountBalanceUpdate
AFTER UPDATE ON Accounts
FOR EACH ROW
BEGIN
    IF OLD.balance <> NEW.balance THEN
        INSERT INTO AuditLogs
        (action_type, table_name, record_id, action_description)
        VALUES
        (
            'UPDATE',
            'Accounts',
            NEW.account_id,
            CONCAT(
                'Account balance changed from ',
                OLD.balance,
                ' to ',
                NEW.balance
            )
        );
    END IF;
END //

