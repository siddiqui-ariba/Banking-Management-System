-- STEP 47 — SELF JOIN
-- 1. Find pairs of employees who work in the same branch.
SELECT
    CONCAT(e1.first_name, ' ', e1.last_name) AS employee_1,
    CONCAT(e2.first_name, ' ', e2.last_name) AS employee_2,
    e1.branch_id
FROM Employees e1
INNER JOIN Employees e2
    ON e1.branch_id = e2.branch_id
   AND e1.employee_id < e2.employee_id;
   
-- 2. Find employees who have the same job title.
SELECT
    CONCAT(e1.first_name, ' ', e1.last_name) AS employee_1,
    CONCAT(e2.first_name, ' ', e2.last_name) AS employee_2,
    e1.job_title
FROM Employees e1
INNER JOIN Employees e2
    ON e1.job_title = e2.job_title
   AND e1.employee_id < e2.employee_id;
   
-- 3. Find employees working in the same branch with different salaries.
SELECT
    CONCAT(e1.first_name, ' ', e1.last_name) AS employee_1,
    e1.salary AS salary_1,
    CONCAT(e2.first_name, ' ', e2.last_name) AS employee_2,
    e2.salary AS salary_2,
    e1.branch_id
FROM Employees e1
INNER JOIN Employees e2
    ON e1.branch_id = e2.branch_id
   AND e1.salary <> e2.salary
   AND e1.employee_id < e2.employee_id;
   
-- 4. Find employees whose salary is higher than another employee in the same branch.
SELECT
    CONCAT(e1.first_name, ' ', e1.last_name) AS higher_paid_employee,
    e1.salary AS higher_salary,
    CONCAT(e2.first_name, ' ', e2.last_name) AS lower_paid_employee,
    e2.salary AS lower_salary,
    e1.branch_id
FROM Employees e1
INNER JOIN Employees e2
    ON e1.branch_id = e2.branch_id
   AND e1.salary > e2.salary;
   
-- 5. Find employees who joined later than another employee in the same branch.
SELECT
    CONCAT(e1.first_name, ' ', e1.last_name) AS later_employee,
    e1.hire_date AS later_hire_date,
    CONCAT(e2.first_name, ' ', e2.last_name) AS earlier_employee,
    e2.hire_date AS earlier_hire_date,
    e1.branch_id
FROM Employees e1
INNER JOIN Employees e2
    ON e1.branch_id = e2.branch_id
   AND e1.hire_date > e2.hire_date;
   
